---
// ImageModule 对应的 CSS 需要设置为 is::global 才能被正确应用

import { Image } from "astro:assets";
import path from "node:path"

interface Props {
    src: string;
    alt?: string;
    id?: string;
    class?: string;
    width?: number;
    height?: number;
}

const { src, alt, id } = Astro.props;
const className = Astro.props.class;

const isLocal = !(
    src.startsWith("/") ||
    src.startsWith("http")
);

let imageLoad: ImageMetadata | undefined;
if (isLocal) {
    const images = import.meta.glob<ImageMetadata>("../../**/*.{avif,gif,jpeg,jpg,png,svg,webp}", {import: "default" });
    const imagePath = path.normalize(path.join("../../", "/", src)).replace(/\\/g, "/");
    const image = images[imagePath];
    if (image) {
        imageLoad = await image();
    } else {
        console.error(`\n[ERROR] Image file not found: ${imagePath.replace('../../', 'src/')}`);
    }
}
---
<!-- <div class={className}> -->
    { 
    isLocal && imageLoad && 
    <Image src={imageLoad} alt={alt || ""}  id={id || ""} class={className || ""}/>
    }
    {
    !isLocal &&
    <img src={src} alt={alt || ""}  id={id || ""} class={className || ""}/>
    }
<!-- </div> -->