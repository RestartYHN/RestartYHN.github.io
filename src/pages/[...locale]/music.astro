---
import MainPageLayout from '@layouts/MainPageLayout.astro';
import Cover from '@components/Cover.astro';
import FabMenu from '@components/control/FabMenu.astro';
import Comments from '@components/comment/Comments.svelte';
import MusicPage from '@components/music/MusicPage.svelte';
import { siteConfig } from '@/config';
import i18nit from '@i18n/translation';
import { i18n } from 'astro:config/client';

export async function getStaticPaths() {
  return i18n?.locales.map((locale) => ({
    params: { locale: locale == i18n?.defaultLocale ? undefined : (locale as string) },
  }));
}

const currentLang = Astro.currentLocale || i18n!.defaultLocale;
const t = i18nit(currentLang);
const isEn = currentLang === 'en';
const pageTitle = `${t('header.music')} - ${siteConfig.title}`;
---

<MainPageLayout title={pageTitle} lang={currentLang} noCache={true}>
  <div class="mx-auto w-full max-w-[var(--page-width)]">
    <Cover
      title={isEn ? 'Music' : '音乐'}
      subTitle={isEn
        ? 'My NetEase Cloud playlists, with synced lyrics. The global player keeps the music going as you browse other pages.'
        : '我收藏的网易云歌单，支持同步歌词；内置全局播放器，切换页面也能继续收听。'
      }
    />

    <MusicPage client:only="svelte" isEn={isEn} />

    <Comments
        client:load
        postSlug="music"
        postTitle={pageTitle}
        language={currentLang}
      />

  </div>

  <FabMenu showBackBottom={true} />
</MainPageLayout>

<style is:global>
  .music-main-grid {
    display: grid;
    /* minmax(0, …) lets columns shrink below their content; otherwise long titles
       force the grid wider than the viewport on mobile. */
    grid-template-columns: minmax(0, 360px) minmax(0, 420px);
    grid-template-rows: auto auto auto auto auto auto;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .music-main-grid > * {
    min-width: 0;
  }

  @media (max-width: 1024px) {
    .music-main-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .music-hero {
    position: relative;
    border-radius: 1rem;
    overflow: hidden;
    border: 1px solid var(--button-border-color);
    grid-column: 1;
    grid-row: 1;
  }

  @media (max-width: 1024px) {
    .music-hero {
      grid-column: 1;
      grid-row: 1;
    }
  }

  .music-lyrics-panel {
    grid-column: 2;
    grid-row: 1;
  }

  @media (max-width: 1024px) {
    .music-lyrics-panel {
      grid-column: 1;
      grid-row: 2;
    }
  }

  .music-playlist-section {
    grid-column: 1;
    grid-row: 2;
  }

  .music-playlist-section {
    grid-column: 1;
    grid-row: 2;
  }

  .music-album-section {
    grid-column: 1;
    grid-row: 3;
  }

  .music-col-tight {
    grid-column: 2;
    grid-row: 3;
    align-self: start;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .music-mini-section {
    flex-shrink: 0;
  }

  .music-tracks-section {
    grid-column: 2;
    grid-row: 2;
  }

  @media (max-width: 1024px) {
    .music-playlist-section { grid-column: 1; grid-row: 3; }
    .music-tracks-section  { grid-column: 1; grid-row: 4; }
    .music-col-tight       { grid-column: 1; grid-row: 5; }
    .music-album-section   { grid-column: 1; grid-row: 6; }
  }

  .music-hero-bg {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 20% 20%, rgba(213, 165, 106, 0.2), transparent 48%),
      linear-gradient(135deg, rgba(0, 0, 0, 0.08), transparent 60%);
    filter: saturate(1.1);
  }

  .music-hero-content {
    position: relative;
    z-index: 1;
    padding: 1.1rem;
    backdrop-filter: blur(5px);
  }

  .music-status {
    margin: 0 0 0.8rem;
    padding: 0.5rem 0.8rem;
    border-radius: 0.6rem;
    border: 1px solid color-mix(in oklab, #d5a56a 40%, var(--button-border-color));
    background: color-mix(in oklab, #d5a56a 14%, transparent);
    color: var(--text-color-70);
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .music-status.hidden {
    display: none;
  }

  .music-now-card,
  .music-panel {
    border: 1px solid var(--button-border-color);
    border-radius: 0.95rem;
    padding: 1rem;
    background: color-mix(in oklab, var(--bg-color) 88%, transparent);
  }

  .music-cover {
    width: 100%;
    aspect-ratio: 1/1;
    border-radius: 0.8rem;
    background: var(--button-hover-color);
    background-size: cover;
    background-position: center;
    margin-bottom: 0.8rem;
  }

  .music-title {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text-color);
    overflow-wrap: anywhere;
  }

  .music-artist,
  .music-panel-subtitle {
    color: var(--text-color-70);
  }

  .music-panel-title {
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--text-color);
  }

  .music-lyrics-panel {
    position: relative;
    height: 500px;
    overflow: hidden;
    border: none;
    background: transparent;
    border-radius: 0;
    padding: 0.5rem 1rem;
  }

  @media (max-width: 1024px) {
    .music-lyrics-panel {
      height: 400px;
    }
  }

  @media (max-width: 768px) {
    .music-lyrics-panel {
      height: 350px;
    }
  }

  .music-search-wrap {
    position: relative;
    margin-bottom: 0.5rem;
  }
  .music-search-input {
    width: 100%;
    padding: 0.35rem 0.6rem;
    border: 1px solid var(--button-border-color);
    border-radius: 0.5rem;
    background: color-mix(in oklab, var(--bg-color) 95%, transparent);
    color: var(--text-color);
    font-size: 0.85rem;
    outline: none;
  }
  .music-search-input:focus { border-color: var(--link-color); }
  .music-search-results {
    position: absolute;
    top: calc(100% + 4px);
    left: 0;
    right: 0;
    z-index: 20;
    max-height: 300px;
    overflow-y: auto;
    border: 1px solid var(--button-border-color);
    border-radius: 0.6rem;
    background: var(--bg-color);
    box-shadow: 0 12px 32px rgba(0,0,0,0.18);
    padding: 0.25rem 0;
  }
  .music-search-results.hidden { display: none; }
  .music-search-result-item {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.6rem 0.75rem;
    cursor: pointer;
    border-bottom: 1px solid color-mix(in oklab, var(--button-border-color) 40%, transparent);
    transition: background-color 0.12s;
  }
  .music-search-result-item:last-child { border-bottom: none; }
  .music-search-result-item:hover { background: var(--button-hover-color); }
  .music-search-result-item.active {
    background: var(--button-hover-color);
    border-left: 3px solid var(--link-color);
  }
  .music-search-result-cover {
    width: 36px; height: 36px;
    border-radius: 4px;
    background-color: var(--button-hover-color);
    flex-shrink: 0;
    object-fit: cover;
  }
  .music-search-result-text {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .music-search-result-title {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-color);
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    line-height: 1.35;
  }
  .music-search-result-artist {
    font-size: 0.78rem;
    color: var(--text-color-70);
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    line-height: 1.2;
  }

  .lyrics-container {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to bottom,
        transparent 0%,
        rgba(0,0,0,0.3) 8%,
        black 18%,
        black 82%,
        rgba(0,0,0,0.3) 92%,
        transparent 100%);
    mask-image: linear-gradient(to bottom,
        transparent 0%,
        rgba(0,0,0,0.3) 8%,
        black 18%,
        black 82%,
        rgba(0,0,0,0.3) 92%,
        transparent 100%);
  }

  .lyrics-container.is-static {
    overflow-y: auto;
    -webkit-mask-image: none;
    mask-image: none;
    scroll-behavior: smooth;
  }

  .lyrics-track {
    position: absolute;
    width: 100%;
    top: 0;
    left: 0;
    will-change: transform;
    transition: transform 0.12s ease-out;
  }

  .lyrics-line {
    text-align: center;
    padding: 0.45rem 1rem;
    opacity: 0.65;
    transition: opacity 0.35s ease, font-size 0.35s ease, color 0.35s ease;
    cursor: pointer;
    user-select: none;
    font-size: 0.92rem;
    line-height: 1.8;
  }

  .lyrics-line.active {
    opacity: 1;
    font-size: 1.12rem;
    font-weight: 600;
  }

  .lyrics-line.near {
    opacity: 0.88;
    font-size: 0.96rem;
  }

  .lyrics-main {
    color: var(--text-color);
  }

  .lyrics-trans {
    margin-top: 0.15rem;
    font-size: 0.86rem;
    color: var(--text-color-70);
  }

  .lyrics-line.active .lyrics-main {
    color: var(--text-color);
  }

  .lyrics-line.active .lyrics-trans {
    color: color-mix(in oklab, var(--text-color) 65%, transparent);
  }

  .lyrics-static {
    opacity: 0.85;
    font-size: 0.95rem;
    font-weight: normal;
    cursor: default;
    text-align: left;
    padding: 0.3rem 0.5rem;
  }
  .lyrics-static .lyrics-main {
    color: var(--text-color-70);
  }

  .music-track-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    max-height: 500px;
    overflow-y: auto;
  }

  .music-track-card {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    border: 1px solid var(--button-border-color);
    border-radius: 0.9rem;
    background: color-mix(in oklab, var(--bg-color) 95%, transparent);
    padding: 0.7rem;
    cursor: pointer;
    transition: background-color 160ms ease, transform 160ms ease;
    min-height: 3.2rem;
  }

  .music-track-card { border-bottom: 1px solid color-mix(in oklab, var(--button-border-color) 40%, transparent); }
  .music-track-card:hover { background: var(--button-hover-color) !important; border-color: var(--link-color) !important; }
  .music-playlist-card { border-bottom: 1px solid color-mix(in oklab, var(--button-border-color) 40%, transparent); }
  .music-playlist-card:hover { background: var(--button-hover-color) !important; border-color: var(--link-color) !important; }

  .music-track-index {
    width: 2rem;
    text-align: center;
    font-size: 0.86rem;
    font-weight: 700;
    color: var(--text-color-70);
    flex-shrink: 0;
  }

  .music-track-card.active {
    background: var(--button-hover-color);
    border-color: #d5a56a;
  }

  .music-track-card.unavailable {
    opacity: 0.55;
    cursor: not-allowed;
  }

  .music-track-card.unavailable:hover {
    background: color-mix(in oklab, var(--bg-color) 95%, transparent);
    transform: none;
  }

  .music-track-card:hover {
    background: var(--button-hover-color);
  }

  .music-track-card.loading {
    opacity: 0.6;
    pointer-events: none;
  }

  .music-track-played {
    margin-top: 0.15rem;
    color: var(--text-color-70);
    font-size: 0.75rem;
  }

  .music-track-title {
    margin: 0;
    color: var(--text-color);
    font-size: 0.98rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .music-track-artist {
    margin-top: 0.2rem;
    color: var(--text-color-70);
    font-size: 0.85rem;
  }

  .music-playlist-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    max-height: 500px;
    overflow-y: auto;
  }

  .music-playlist-card {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    border: 1px solid var(--button-border-color);
    border-radius: 0.9rem;
    background: color-mix(in oklab, var(--bg-color) 95%, transparent);
    padding: 0.75rem 0.8rem;
    cursor: pointer;
    transition: background-color 160ms ease, transform 160ms ease, opacity 160ms ease;
    position: relative;
    min-height: 3.2rem;
  }

  .music-playlist-card:not(.loading):hover {
    background: var(--button-hover-color);
    border-color: var(--link-color);
  }

  .music-playlist-index {
    width: 2rem;
    text-align: center;
    font-size: 0.86rem;
    font-weight: 700;
    color: var(--text-color-70);
    flex-shrink: 0;
  }

  .music-playlist-card.active {
    background: var(--button-hover-color);
    border-color: #d5a56a;
  }

  .music-playlist-card.loading {
    opacity: 0.6;
    pointer-events: none;
  }

  .music-playlist-card.loading::after {
    content: '';
    position: absolute;
    right: 0.8rem;
    top: 50%;
    transform: translateY(-50%);
    width: 14px;
    height: 14px;
    border: 2px solid var(--text-color-70);
    border-top-color: #d5a56a;
    border-radius: 50%;
    animation: music-spin 0.6s linear infinite;
  }

  @keyframes music-spin {
    to {
      transform: translateY(-50%) rotate(360deg);
    }
  }

  .music-playlist-name {
    margin: 0;
    font-size: 0.98rem;
    font-weight: 700;
    color: var(--text-color);
    line-height: 1.35;
    display: block;
    max-height: 2.4rem;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .music-playlist-meta {
    margin-top: 0.3rem;
    color: var(--text-color-70);
    font-size: 0.82rem;
    line-height: 1.2;
  }

  .music-empty {
    color: var(--text-color-70);
    padding: 1rem;
    text-align: center;
  }

  /* Svelte rewrite: cards are <button> now; normalize + scrollable lyrics. */
  .music-track-card,
  .music-playlist-card,
  .music-search-result-item {
    width: 100%;
    text-align: left;
    font: inherit;
  }

  /* Search result rows: reset native button chrome so they look like the old bars. */
  button.music-search-result-item {
    border: none;
    border-bottom: 1px solid color-mix(in oklab, var(--button-border-color) 40%, transparent);
    background: transparent;
    color: inherit;
    appearance: none;
    border-radius: 0;
  }

  button.music-search-result-item:last-child {
    border-bottom: none;
  }

  .lyrics-container.is-scroll {
    overflow-y: auto;
    -webkit-mask-image: none;
    mask-image: none;
    scroll-behavior: smooth;
    overscroll-behavior: contain;
  }

  .lyrics-container.is-scroll .lyrics-track {
    position: relative;
    transform: none !important;
  }
</style>

