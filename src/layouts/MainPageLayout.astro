---
import Layout from '@layouts/Layout.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import Search from '@components/misc/Search.astro';
import MiniPlayer from '@components/music/MiniPlayer.svelte';
import '@styles/music-player.css';


interface Props {
  title: string;
  lang: string;
  description?: string;
  noCache?: boolean;
}
const { title, lang, description, noCache = false } = Astro.props;
const isEn = lang === 'en';

---

<Layout title={title} lang={lang} description={description} noCache={noCache}>
  <div class="flex flex-col min-h-screen">
    <Header />
    <main class="flex-grow pb-28 md:pb-24">
      <slot />
    </main>
    <MiniPlayer client:load transition:persist isEn={isEn} />
    <Footer />
    <Search />
  </div>
</Layout>